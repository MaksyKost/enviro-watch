# PostgreSQL
POSTGRES_USER=envirowatch
POSTGRES_PASSWORD=envirowatch
POSTGRES_DB=envirowatch

# ASP.NET Core (used when running API locally)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=envirowatch;Username=envirowatch;Password=envirowatch
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Auth (Phase 4)
JWT_SECRET=change-me-in-production-min-32-characters-long

# External APIs (Phase 6)
OPENWEATHER_API_KEY=
